---
source: crates/simjig-macros/src/test_attr.rs
expression: "render(quote!(timeout = \"1us\", duts = [fifo::small::Dut, fifo::big::Dut]),\nquote!\n{\n    #[doc = r\" Docs go on the module.\"] #[ignore] pub async fn resets<D:\n    fifo::Ports>(sim: &TestCtx, dut: D) -> simjig::Result { Ok(()) }\n})"
