// Drives the counter for `cycles` clock cycles after reset and returns `count`.
#include <cstdint>
#include "verilated.h"
#include "@PREFIX@.h"

extern "C" uint32_t counter_run(uint32_t cycles) {
    VerilatedContext ctx;
    @PREFIX@ m{&ctx, "top"};
    m.clk = 0; m.rst_n = 0; m.eval();
    m.clk = 1; m.eval();
    m.clk = 0; m.rst_n = 1; m.eval();
    for (uint32_t i = 0; i < cycles; ++i) {
        m.clk = 1; m.eval();
        m.clk = 0; m.eval();
    }
    uint32_t count = m.count;
    m.final();
    return count;
}
