// @generated by simjig-build: flat-port top for `producer`. Do not edit.
// verilator lint_off TIMESCALEMOD
module simjig_wrap_producer (
  input  logic go,
  output logic [15:0] bus_data,
  output logic bus_valid,
  input  logic bus_ready,
  input  logic bus_clk
);

  bus_if #(.W(16)) bus (.clk(bus_clk));
  assign bus_data = bus.data;
  assign bus_valid = bus.valid;
  assign bus.ready = bus_ready;

  producer dut (
    .go(go),
    .bus(bus.src)
  );
endmodule
